VITE_BACKEND_PROVIDER=LOCAL_SAFE
VITE_BACKEND_ENABLED=false
VITE_AUTH_ENABLED=false
VITE_SUBSCRIPTION_ENABLED=false
VITE_SOCIAL_ENABLED=false

# Pour une integration Supabase ulterieure:
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# VITE_CONTACT_FUNCTION_URL=https://YOUR_PROJECT.supabase.co/functions/v1/send-contact-email

# Option la plus simple (100% gratuit, sans domaine): Web3Forms
# VITE_WEB3FORMS_ACCESS_KEY=

# Pour activer les comptes online (Supabase Auth):
# VITE_BACKEND_PROVIDER=SUPABASE
# VITE_BACKEND_ENABLED=true
# VITE_AUTH_ENABLED=true

# Email unique autorise pour le bouton Modo ON/OFF
# VITE_MODO_ADMIN_EMAIL=nivelr2026@gmail.com
